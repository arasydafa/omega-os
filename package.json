{
  "name": "@omega-os/ui",
  "version": "1.0.1",
  "description": "OmegaOS Design System — modern minimalist tokens (Plus Jakarta Sans + JetBrains Mono, navy/maroon/grey, light + dark, rounded, lucide icons only)",
  "author": "Arasy Dafa Sulistya Kurniawan",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.preset.js",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.cjs",
    "verify": "node scripts/verify-dist.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "omega-os",
    "design-system",
    "tailwindcss",
    "tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arasydafa/omega-os.git"
  },
  "homepage": "https://arasydafa.github.io/omega-os/",
  "bugs": {
    "url": "https://github.com/arasydafa/omega-os/issues"
  }
}
